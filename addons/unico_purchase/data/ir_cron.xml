<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Urgency is relative to today, so open purchases must be re-bucketed
         daily even when their own data does not change. -->
    <record id="ir_cron_recompute_unico_urgency" model="ir.cron">
        <field name="name">Unico: Recompute Purchase Sales-Urgency</field>
        <field name="model_id" ref="purchase.model_purchase_order"/>
        <field name="state">code</field>
        <field name="code">model._cron_recompute_unico_urgency()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
