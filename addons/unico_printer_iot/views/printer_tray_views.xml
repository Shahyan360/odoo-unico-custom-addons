<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_printer_tray_list" model="ir.ui.view">
        <field name="name">printer.tray.list</field>
        <field name="model">printer.tray</field>
        <field name="arch" type="xml">
            <list decoration-danger="status == 'empty'" decoration-warning="status == 'low'">
                <field name="device_id"/>
                <field name="tray_index"/>
                <field name="name"/>
                <field name="current_level"/>
                <field name="max_capacity"/>
                <field name="level_percent" widget="progressbar"/>
                <field name="status" widget="badge"
                       decoration-danger="status == 'empty'"
                       decoration-warning="status == 'low'"
                       decoration-success="status == 'ok'"/>
                <field name="last_update"/>
            </list>
        </field>
    </record>

    <record id="view_printer_tray_search" model="ir.ui.view">
        <field name="name">printer.tray.search</field>
        <field name="model">printer.tray</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="device_id"/>
                <filter name="empty" string="Empty" domain="[('status','=','empty')]"/>
                <filter name="low" string="Low" domain="[('status','=','low')]"/>
                <group>
                    <filter name="group_device" string="Printer" context="{'group_by': 'device_id'}"/>
                    <filter name="group_status" string="Status" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_printer_tray" model="ir.actions.act_window">
        <field name="name">Trays</field>
        <field name="res_model">printer.tray</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_printer_tray_search"/>
    </record>

</odoo>
