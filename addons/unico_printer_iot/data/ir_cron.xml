<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cron_poll_printers" model="ir.cron">
        <field name="name">Printer IoT: Poll tray levels (SNMP)</field>
        <field name="model_id" ref="iot.model_iot_device"/>
        <field name="state">code</field>
        <field name="code">model._cron_poll_all()</field>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
