<odoo>
    <data>
        <record id="gen_return_order_view_form" model="ir.ui.view">
            <field name="name">wizard for return action</field>
            <field name="model">return.order</field>
            <field name="arch" type="xml">
                <form string="Choose Return Action">
                    <sheet>
                        <list>
                            <field name="show_replacement_tab" invisible="1"/>
                        </list>
                        <notebook>
                            <page string="Returned Items">
                                <field name="rma_order_id" invisible="1" />
                                <field name="rma_type" invisible="1" />
                                <field name="rol_ids">
                                    <form create="false" delete="false">
                                        <group>
                                            <field name="rma_line_id" invisible="1" />
                                            <field name="product_id" invisible="1" />
                                            <field name="original_description" readonly="1" />
                                            <field name="return_scope_label" readonly="1" />
                                            <field name="return_component_summary" readonly="1" />
                                        </group>
                                        <group>
                                            <group>
                                                <field name="return_reason_id"
                                                    domain="[('is_customer_return_reason','=',True)]"
                                                    options="{'no_create': True, 'no_open': True}" />
                                                <field name="rma_resolution_id"
                                                    options="{'no_create': True, 'no_open': True}" />
                                            </group>
                                            <group>
                                                <field name="delivery_qty" readonly="1" />
                                                <field name="pending_qty" readonly="1" />
                                                <field name="return_qty" />
                                            </group>
                                        </group>
                                    </form>
                                    <list create="false" delete="false" edit="true"
                                        editable="bottom">
                                        <field name="rma_line_id" column_invisible="1" />
                                        <field name="tracking" column_invisible="1" />
                                        <field name="product_id" column_invisible="1"
                                            readonly="1" force_save="1" />
                                        <field name="original_description" string="Description"
                                            readonly="1" />
                                        <field name="return_scope_label" readonly="1" />
                                        <field name="return_component_summary" readonly="1"
                                            optional="show" />
                                        <field name="return_reason_id" force_save="1"
                                            domain="[('is_customer_return_reason','=',True)]"
                                            options="{'no_create': True, 'no_open': True}" />
                                        <field name="rma_resolution_id" force_save="1"
                                            options="{'no_create': True, 'no_open': True}" />
                                        <field name="delivery_qty" readonly='1' optional="show"
                                            force_save="1" />
                                        <field name="pending_qty" readonly='1' optional="hide"
                                            force_save="1" />
                                        <field name="return_qty" force_save="1" />
                                        <field name="received_qty" column_invisible="1" />
                                        <field name="sale_line_id" column_invisible="1" />
                                        <field name="is_new_line" column_invisible="1" />
                                    </list>
                                </field>
                            </page>

                            <page name="Replace" string="Replacement Products"
                                invisible="not show_replacement_tab">
                                <field name="rma_order_id" invisible="1" />
                                <field name="is_service" invisible="1" />
                                <field name="replace_prd_ids">
                                    <list create="true" delete="true" edit="true" editable="bottom">
                                        <field name="rma_id" column_invisible="1" />
                                        <field name="product_id"
                                            options="{'no_create': True,'no_edit': True,'no_open': True}" />
                                        <field name="detailed_type" column_invisible="1" />
                                        <field name="qty" readonly="detailed_type == 'service'"
                                            force_save="1" />
                                        <field name="price_unit_manual" string="Manual Price" />
                                        <field name="manual_price_unit" column_invisible="1" />
                                        <field name="price_unit"
                                            readonly="not price_unit_manual" />
                                        <field name="total_price" readonly="1" />
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <footer>
                        <button name="update_rma_lines" class="btn-primary" string="Apply"
                            type="object" />
	                        <button string="Close" class="btn-secondary" special="save" data-hotkey="v" />
                    </footer>
                </form>
            </field>
        </record>

        <record id="view_rma_reject_wizard_form" model="ir.ui.view">
            <field name="name">rma.reject.wizard.form</field>
            <field name="model">rma.reject.wizard</field>
            <field name="arch" type="xml">
	                <form string="Reject RMA">
                    <group>
                        <field name="rma_id" invisible="1"/>
                        <field name="reject_reason"
                            placeholder="Why is this RMA being rejected?"
                            nolabel="1"/>
                    </group>
                    <footer>
	                        <button name="action_confirm" string="Reject RMA"
	                            type="object" class="btn-danger"/>
                        <button special="cancel" string="Discard" class="btn-secondary"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>
