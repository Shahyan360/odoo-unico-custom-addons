<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="payment_link_balance_changed" name="Combined payment balance changed">
        <t t-call="portal.portal_layout">
            <div class="container py-5">
                <div class="row justify-content-center">
                    <div class="col-12 col-md-8 col-lg-6">
                        <div class="alert alert-warning mb-4" role="alert">
                            <h1 class="h3 mb-3">Your balance has changed</h1>
                            <p class="mb-0">
                                This payment link was created before the balance on these
                                invoices changed, so the previous total can no longer be paid.
                            </p>
                        </div>
                        <t t-if="refresh_complete">
                            <div class="alert alert-success mb-0" role="status">
                                These invoices no longer have an open balance. No additional
                                payment was taken, and the outdated payment attempt was closed.
                            </div>
                        </t>
                        <t t-elif="refresh_error">
                            <div class="alert alert-danger mb-0" role="alert">
                                <t t-out="refresh_error"/>
                            </div>
                        </t>
                        <t t-else="">
                            <p>
                                The current open balance is
                                <strong t-out="formatted_current_amount"/>.
                            </p>
                            <div class="table-responsive mb-4">
                                <table class="table table-sm align-middle">
                                    <thead>
                                        <tr>
                                            <th>Invoice</th>
                                            <th>Due</th>
                                            <th class="text-end">Original</th>
                                            <th class="text-end">Open balance</th>
                                            <th>Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr t-foreach="invoice_breakdown" t-as="invoice">
                                            <td t-out="invoice['name']"/>
                                            <td t-out="invoice['invoice_date_due'] or '-'"/>
                                            <td class="text-end"
                                                t-out="invoice['amount_total']"/>
                                            <td class="text-end"
                                                t-out="invoice['amount_residual']"/>
                                            <td>
                                                <span t-if="invoice['is_open']"
                                                      class="badge text-bg-warning">
                                                    Open
                                                </span>
                                                <span t-else=""
                                                      class="badge text-bg-success">
                                                    Settled
                                                </span>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                            <form t-att-action="refresh_route" method="post">
                                <input type="hidden" name="invoice_ids"
                                       t-att-value="invoice_ids"/>
                                <input type="hidden" name="amount"
                                       t-att-value="signed_amount"/>
                                <input type="hidden" name="access_token"
                                       t-att-value="access_token"/>
                                <button type="submit" class="btn btn-primary">
                                    <t t-if="remaining_invoice_count &gt; 1">
                                        Continue with current balance
                                    </t>
                                    <t t-elif="remaining_invoice_count == 1">
                                        Open remaining invoice
                                    </t>
                                    <t t-else="">
                                        Confirm balance update
                                    </t>
                                </button>
                            </form>
                        </t>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="payment_link_expired" name="Combined payment link expired">
        <t t-call="portal.portal_layout">
            <div class="container py-5">
                <div class="row justify-content-center">
                    <div class="col-12 col-lg-8">
                        <div class="alert alert-warning mb-4" role="alert">
                            <h1 class="h3 mb-3">This payment link has expired</h1>
                            <p class="mb-0">
                                No payment was taken. Contact Accounts Receivable
                                for a new link with the current invoice balance.
                            </p>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-sm align-middle">
                                <thead>
                                    <tr>
                                        <th>Invoice</th>
                                        <th>Due</th>
                                        <th class="text-end">Open balance</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="invoice_breakdown" t-as="invoice">
                                        <td t-out="invoice['name']"/>
                                        <td t-out="invoice['invoice_date_due'] or '-'"/>
                                        <td class="text-end"
                                            t-out="invoice['amount_residual']"/>
                                        <td>
                                            <span t-if="invoice['is_open']"
                                                  class="badge text-bg-warning">
                                                Open
                                            </span>
                                            <span t-else=""
                                                  class="badge text-bg-success">
                                                Settled
                                            </span>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>
