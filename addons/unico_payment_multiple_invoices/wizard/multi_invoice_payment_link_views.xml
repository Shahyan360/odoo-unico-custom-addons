<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_multi_invoice_payment_link_form" model="ir.ui.view">
        <field name="name">unico.multi.invoice.payment.link.form</field>
        <field name="model">unico.multi.invoice.payment.link</field>
        <field name="arch" type="xml">
            <form string="Payment Link">
                <div class="alert alert-info" role="alert">
                    Share this link with the customer. Paying it settles the
                    combined balance of all selected invoices in one transaction.
                </div>
                <group>
                    <group>
                        <field name="partner_id"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="amount" widget="monetary"/>
                    </group>
                </group>
                <group>
                    <field name="payment_link" widget="CopyClipboardChar" nolabel="1"/>
                </group>
                <field name="invoice_ids" nolabel="1">
                    <list>
                        <field name="name"/>
                        <field name="invoice_date"/>
                        <field name="amount_total" widget="monetary"/>
                        <field name="amount_residual" widget="monetary"/>
                        <field name="currency_id" column_invisible="1"/>
                        <field name="payment_state"/>
                    </list>
                </field>
                <footer>
                    <button string="Close" class="btn-primary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
