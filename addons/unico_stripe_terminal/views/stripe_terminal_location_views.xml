<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="stripe_terminal_location_view_list" model="ir.ui.view">
        <field name="name">stripe.terminal.location.list</field>
        <field name="model">stripe.terminal.location</field>
        <field name="arch" type="xml">
            <list string="Terminal Locations">
                <field name="name"/>
                <field name="address_city"/>
                <field name="address_country"/>
                <field name="reader_count" string="Readers"/>
                <field name="stripe_location_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="stripe_terminal_location_view_form" model="ir.ui.view">
        <field name="name">stripe.terminal.location.form</field>
        <field name="model">stripe.terminal.location</field>
        <field name="arch" type="xml">
            <form string="Terminal Location">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="stripe_location_id" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Address">
                            <field name="address_line1"/>
                            <field name="address_city"/>
                            <field name="address_state"/>
                            <field name="address_postal_code"/>
                            <field name="address_country"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Readers" name="readers">
                            <group>
                                <field name="default_reader_id"
                                       options="{'no_create': True}"/>
                            </group>
                            <field name="reader_ids">
                                <list>
                                    <field name="label"/>
                                    <field name="device_type"/>
                                    <field name="status"/>
                                    <field name="is_simulated"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="stripe_terminal_location_action" model="ir.actions.act_window">
        <field name="name">Terminal Locations</field>
        <field name="res_model">stripe.terminal.location</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No Stripe Terminal locations yet</p>
            <p>Open your <b>Stripe</b> payment provider (Configuration &gt; Payment
               Providers), Stripe Terminal tab, and click <b>Sync Locations</b>.</p>
        </field>
    </record>

</odoo>
