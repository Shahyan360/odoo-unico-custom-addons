<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Show the provider's ACH Help Message under the ACH (bank debit)
         payment method on the payment page, mirroring the standard
         provider Help Message (pre_msg) but scoped to ACH only. -->
    <template id="payment_method_form_ach_help" inherit_id="payment.method_form">
        <xpath expr="//div[t[@t-out='provider_sudo.pre_msg']]" position="after">
            <div t-if="pm_sudo.code == 'ach_direct_debit' and not is_html_empty(provider_sudo.ach_pre_msg)"
                 class="w-100 mb-0 ms-4 small text-600"
            >
                <t t-out="provider_sudo.ach_pre_msg"/>
            </div>
        </xpath>
    </template>

</odoo>
