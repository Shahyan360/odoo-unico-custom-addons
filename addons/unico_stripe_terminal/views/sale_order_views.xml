<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_order_form_stripe_terminal" model="ir.ui.view">
        <field name="name">sale.order.form.stripe.terminal</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Header button to launch the collection wizard.
                 Shown while the order still has an amount due. -->
            <xpath expr="//header" position="inside">
                <field name="stripe_terminal_amount_due" invisible="1"/>
                <button name="action_collect_stripe_terminal_payment"
                        type="object"
                        string="Collect Payment"
                        class="btn-primary"
                        icon="fa-credit-card"
                        invisible="stripe_terminal_amount_due &lt;= 0 or state == 'cancel'"
                        groups="unico_stripe_terminal.group_stripe_terminal_user"/>
            </xpath>
            <!-- Smart button with the count of terminal payments -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_stripe_terminal_payments"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-credit-card"
                        groups="account.group_account_invoice,account.group_account_readonly"
                        invisible="stripe_terminal_payment_count == 0">
                    <field name="stripe_terminal_payment_count" widget="statinfo"
                           string="Payments"/>
                </button>
                <!-- Smart button to the order's pending (uncleared) online payments -->
                <button name="action_view_pending_payment_transactions"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-hourglass-half"
                        groups="account.group_account_invoice"
                        invisible="pending_payment_transaction_count == 0">
                    <field name="pending_payment_transaction_count" widget="statinfo"
                           string="Pending Payment"/>
                </button>
            </xpath>
            <!-- "Pending Payment" ribbon while an online payment is uncleared -->
            <xpath expr="//div[@name='button_box']" position="before">
                <field name="has_pending_payment_transaction" invisible="1"/>
                <widget name="web_ribbon" title="Pending Payment"
                        bg_color="text-bg-warning"
                        invisible="not has_pending_payment_transaction"/>
            </xpath>
        </field>
    </record>

</odoo>
