<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="stripe_terminal_payment_view_list" model="ir.ui.view">
        <field name="name">stripe.terminal.payment.list</field>
        <field name="model">stripe.terminal.payment</field>
        <field name="arch" type="xml">
            <list string="Terminal Payments"
                  delete="false"
                  decoration-success="status == 'succeeded'"
                  decoration-danger="status == 'failed'"
                  decoration-muted="status in ('canceled', 'refunded')">
                <field name="name"/>
                <field name="create_date"/>
                <field name="sale_order_id"/>
                <field name="partner_id"/>
                <field name="reader_id"/>
                <field name="amount"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'succeeded'"
                       decoration-danger="status == 'failed'"
                       decoration-warning="status in ('processing', 'requires_action')"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="stripe_terminal_payment_view_form" model="ir.ui.view">
        <field name="name">stripe.terminal.payment.form</field>
        <field name="model">stripe.terminal.payment</field>
        <field name="arch" type="xml">
            <form string="Terminal Payment" delete="false">
                <header>
                    <button name="action_check_status" type="object"
                            string="Check Status" class="btn-primary"
                            invisible="status in ('succeeded', 'refunded')"/>
                    <button name="action_process_on_reader" type="object"
                            string="Retry on Reader" class="btn-secondary"
                            invisible="status not in ('failed', 'canceled')"/>
                    <button name="action_cancel" type="object"
                            string="Cancel" class="btn-secondary"
                            confirm="Cancel this in-progress payment?"
                            invisible="status not in ('draft', 'processing', 'requires_action')"/>
                    <button name="action_refund" type="object"
                            string="Refund" class="btn-secondary"
                            invisible="status != 'succeeded'"/>
                    <field name="status" widget="statusbar"
                           statusbar_visible="draft,processing,succeeded"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="sale_order_id" readonly="1"/>
                            <field name="partner_id" readonly="1"/>
                            <field name="reader_id" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company"
                                   readonly="1"/>
                        </group>
                        <group>
                            <field name="amount" readonly="1"/>
                            <field name="fee_amount" readonly="1"
                                   invisible="not fee_amount"/>
                            <field name="total_charged" readonly="1"
                                   invisible="not fee_amount"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="refunded_amount" readonly="1"
                                   invisible="not refunded_amount"/>
                            <field name="refunded_surcharge_amount" readonly="1"
                                   invisible="not refunded_surcharge_amount"/>
                            <field name="surcharge_refund_move_ids" readonly="1"
                                   widget="many2many_tags"
                                   groups="account.group_account_invoice,account.group_account_readonly"
                                   invisible="not surcharge_refund_move_ids"/>
                            <field name="refund_ids" invisible="1"/>
                            <field name="stripe_card_funding" readonly="1"
                                   invisible="not payment_intent_id"/>
                            <field name="collection_phase" readonly="1"
                                   invisible="not payment_intent_id"/>
                            <field name="account_payment_id" readonly="1"
                                   groups="account.group_account_invoice,account.group_account_readonly"
                                   invisible="not account_payment_id"/>
                            <field name="fee_move_id" readonly="1"
                                   groups="account.group_account_invoice,account.group_account_readonly"
                                   invisible="not fee_move_id"/>
                            <field name="surcharge_sale_order_line_id" readonly="1"
                                   invisible="not surcharge_sale_order_line_id"/>
                            <field name="fee_account_payment_id" readonly="1"
                                   groups="account.group_account_invoice,account.group_account_readonly"
                                   invisible="not fee_account_payment_id"/>
                        </group>
                    </group>
                    <group string="Stripe" groups="base.group_no_one">
                        <field name="payment_intent_id" readonly="1"/>
                        <field name="charge_id" readonly="1"/>
                    </group>
                    <div class="alert alert-danger" role="alert"
                         invisible="not error_message">
                        <field name="error_message" readonly="1" nolabel="1"/>
                    </div>
                    <group string="Refunds" invisible="not refund_ids">
                        <field name="refund_ids" nolabel="1" readonly="1">
                            <list create="false" delete="false">
                                <field name="create_date"/>
                                <field name="stripe_refund_id"/>
                                <field name="base_amount"/>
                                <field name="surcharge_amount"/>
                                <field name="gross_amount"/>
                                <field name="currency_id" column_invisible="1"/>
                                <field name="status" widget="badge"
                                       decoration-success="status == 'succeeded'"
                                       decoration-warning="status in ('pending', 'requires_action')"
                                       decoration-danger="status in ('failed', 'canceled', 'manual_review')"/>
                                <field name="account_payment_id"
                                       groups="account.group_account_invoice,account.group_account_readonly"/>
                                <field name="error_message" optional="show"/>
                            </list>
                        </field>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="stripe_terminal_payment_action" model="ir.actions.act_window">
        <field name="name">Terminal Payments</field>
        <field name="res_model">stripe.terminal.payment</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
