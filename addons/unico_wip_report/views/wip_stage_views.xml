<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_unico_wip_stage_list" model="ir.ui.view">
        <field name="name">unico.wip.stage.list</field>
        <field name="model">unico.wip.stage</field>
        <field name="arch" type="xml">
            <list string="WIP Stages" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="description"/>
                <field name="auto_token"/>
                <field name="fold"/>
                <field name="is_closed"/>
                <field name="item_count" string="Orders"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_unico_wip_stage_form" model="ir.ui.view">
        <field name="name">unico.wip.stage.form</field>
        <field name="model">unico.wip.stage</field>
        <field name="arch" type="xml">
            <form string="WIP Stage">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Awaiting Customer Approval"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="sequence"/>
                            <field name="description"
                                   placeholder="Shown under the column title on the board"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="auto_token"/>
                            <field name="fold"/>
                            <field name="is_closed"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert" invisible="auto_token">
                        This is a <b>manual-only</b> stage. The automatic detector will
                        never move an order here — but you can drag one onto it, which
                        pins that order until someone unpins it.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_unico_wip_stages" model="ir.actions.act_window">
        <field name="name">WIP Stages</field>
        <field name="res_model">unico.wip.stage</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Define your work-in-progress stages</p>
            <p>Stages are the columns of the WIP board. Give a stage an
               <b>Automatic Rule</b> to have the system place orders on it by
               itself; leave the rule empty for a stage you only ever move
               orders onto by hand.</p>
        </field>
    </record>

</odoo>
