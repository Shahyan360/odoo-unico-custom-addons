<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- The order form gets a way IN to the tracker and nothing more: all
         work-in-progress state lives on unico.wip.item, so an ops coordinator
         never needs sale.order write access to run the board. -->
    <record id="view_unico_wip_order_form" model="ir.ui.view">
        <field name="name">sale.order.form.unico.wip</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_unico_view_wip_item"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-tasks"
                        groups="unico_wip_report.group_unico_wip_user"
                        invisible="not unico_wip_item_ids">
                    <div class="o_stat_info">
                        <span class="o_stat_text">WIP</span>
                        <span class="o_stat_text">Tracker</span>
                    </div>
                </button>
                <field name="unico_wip_item_ids" invisible="1"/>
            </xpath>
        </field>
    </record>

</odoo>
