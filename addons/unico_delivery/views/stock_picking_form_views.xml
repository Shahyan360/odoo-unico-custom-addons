<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Green "Printed" ribbon on SPF/SFP transfers once the slip has been
         printed at least once, so operators can see at a glance that any further
         print is a reprint (which carries the "Duplicate Copy N" watermark). -->
    <record id="view_picking_form_unico_printed_ribbon" model="ir.ui.view">
        <field name="name">stock.picking.form.unico.printed.ribbon</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/*[1]" position="before">
                <widget name="web_ribbon" title="Printed" bg_color="text-bg-warning"
                        invisible="not unico_is_spf or unico_report_print_count &lt; 1"/>
                <field name="unico_is_spf" invisible="1"/>
                <field name="unico_report_print_count" invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>
