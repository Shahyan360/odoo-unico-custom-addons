<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Re-evaluate confirmed orders periodically: refreshes the normal-product
         stock-shortfall reason (live stock drift has no dependency path) and
         re-buckets the time-relative material urgency. Door-component and
         special-purchase reasons stay live via @api.depends. -->
    <record id="ir_cron_recompute_unico_material_status" model="ir.cron">
        <field name="name">Unico: Recompute Waiting-on-Materials Status</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="state">code</field>
        <field name="code">model._cron_recompute_unico_material_status()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
