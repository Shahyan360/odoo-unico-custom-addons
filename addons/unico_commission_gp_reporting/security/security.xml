<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_unico_commission_gp" model="ir.module.category">
        <field name="name">Unico Compensation</field>
        <field name="description">Gross profit reporting access for commission review.</field>
        <field name="sequence">55</field>
    </record>

    <record id="unico_commission_gp_privilege_access" model="res.groups.privilege">
        <field name="name">Commission GP Access Level</field>
        <field name="category_id" ref="module_category_unico_commission_gp"/>
    </record>

    <record id="group_unico_commission_gp_user" model="res.groups">
        <field name="name">Commission GP User</field>
        <field name="privilege_id" ref="unico_commission_gp_privilege_access"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Can read their own commissionable GP transaction lines.</field>
    </record>

    <record id="group_unico_commission_gp_manager" model="res.groups">
        <field name="name">Commission GP Manager</field>
        <field name="privilege_id" ref="unico_commission_gp_privilege_access"/>
        <field name="implied_ids" eval="[(4, ref('group_unico_commission_gp_user'))]"/>
        <field name="comment">Can generate monthly GP reports and manage transaction-line classifications.</field>
    </record>

    <record id="group_unico_commission_gp_admin" model="res.groups">
        <field name="name">Commission GP Administrator</field>
        <field name="privilege_id" ref="unico_commission_gp_privilege_access"/>
        <field name="implied_ids" eval="[(4, ref('group_unico_commission_gp_manager'))]"/>
        <field name="comment">Can administer commissionable GP reporting and reopen closed periods.</field>
    </record>

    <!-- Keep salesperson visibility states aligned with PUBLISHED_STATES in models/commission_gp.py. -->
    <record id="unico_commission_gp_period_user_rule" model="ir.rule">
        <field name="name">Commission GP periods: own salesperson</field>
        <field name="model_id" ref="model_unico_commission_gp_period"/>
        <field name="groups" eval="[(4, ref('group_unico_commission_gp_user'))]"/>
        <field name="domain_force">[('salesperson_id', '=', user.id), ('state', 'in', ['ready_for_review', 'approved', 'exported'])]</field>
    </record>

    <record id="unico_commission_gp_period_manager_rule" model="ir.rule">
        <field name="name">Commission GP periods: manager company access</field>
        <field name="model_id" ref="model_unico_commission_gp_period"/>
        <field name="groups" eval="[(4, ref('group_unico_commission_gp_manager'))]"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="unico_commission_gp_line_user_rule" model="ir.rule">
        <field name="name">Commission GP lines: own salesperson</field>
        <field name="model_id" ref="model_unico_commission_gp_line"/>
        <field name="groups" eval="[(4, ref('group_unico_commission_gp_user'))]"/>
        <field name="domain_force">[('salesperson_id', '=', user.id), ('period_id.state', 'in', ['ready_for_review', 'approved', 'exported'])]</field>
    </record>

    <record id="unico_commission_gp_line_manager_rule" model="ir.rule">
        <field name="name">Commission GP lines: manager company access</field>
        <field name="model_id" ref="model_unico_commission_gp_line"/>
        <field name="groups" eval="[(4, ref('group_unico_commission_gp_manager'))]"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="unico_commission_gp_summary_user_rule" model="ir.rule">
        <field name="name">Commission GP summaries: own salesperson</field>
        <field name="model_id" ref="model_unico_commission_gp_salesperson_summary"/>
        <field name="groups" eval="[(4, ref('group_unico_commission_gp_user'))]"/>
        <field name="domain_force">[('salesperson_id', '=', user.id), ('state', 'in', ['ready_for_review', 'approved', 'exported'])]</field>
    </record>

    <record id="unico_commission_gp_summary_manager_rule" model="ir.rule">
        <field name="name">Commission GP summaries: manager company access</field>
        <field name="model_id" ref="model_unico_commission_gp_salesperson_summary"/>
        <field name="groups" eval="[(4, ref('group_unico_commission_gp_manager'))]"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="commission_plan_company_rule" model="ir.rule">
        <field name="name">Commission plans: company access</field>
        <field name="model_id" ref="model_commission_plan"/>
        <field name="groups" eval="[(4, ref('group_unico_commission_gp_user'))]"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="unico_commission_gp_adjustment_user_rule" model="ir.rule">
        <field name="name">Commission GP adjustments: own salesperson</field>
        <field name="model_id" ref="model_unico_commission_gp_adjustment"/>
        <field name="groups" eval="[(4, ref('group_unico_commission_gp_user'))]"/>
        <field name="domain_force">[('salesperson_id', '=', user.id), ('period_id.state', 'in', ['ready_for_review', 'approved', 'exported'])]</field>
    </record>

    <record id="unico_commission_gp_adjustment_manager_rule" model="ir.rule">
        <field name="name">Commission GP adjustments: manager company access</field>
        <field name="model_id" ref="model_unico_commission_gp_adjustment"/>
        <field name="groups" eval="[(4, ref('group_unico_commission_gp_manager'))]"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
