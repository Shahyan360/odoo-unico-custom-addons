<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_commission_plan_list" model="ir.ui.view">
        <field name="name">commission.plan.list</field>
        <field name="model">commission.plan</field>
        <field name="arch" type="xml">
            <list string="Commission Plans">
                <field name="name"/>
                <field name="attribution_basis"/>
                <field name="default_commission_rate" widget="percentage"/>
                <field name="require_cash_collected"/>
                <field name="active" column_invisible="True"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_commission_plan_form" model="ir.ui.view">
        <field name="name">commission.plan.form</field>
        <field name="model">commission.plan</field>
        <field name="arch" type="xml">
            <form string="Commission Plan">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Standard GP Commission Plan"/></h1>
                    </div>
                    <group>
                        <group string="General">
                            <field name="active"/>
                            <field name="default_commission_rate" widget="percentage"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Eligibility &amp; Attribution">
                            <field name="require_cash_collected"/>
                            <field name="attribution_basis"/>
                        </group>
                    </group>
                    <group string="Margin Protection Policy">
                        <group string="Margin Band Starts At">
                            <field name="margin_full_payout_threshold" widget="percentage"/>
                            <field name="margin_reduced_75_threshold" widget="percentage"/>
                            <field name="margin_reduced_50_threshold" widget="percentage"/>
                        </group>
                        <group string="GP Eligible for Commission">
                            <field name="margin_full_payout_factor" widget="percentage"/>
                            <field name="margin_reduced_75_payout_factor" widget="percentage"/>
                            <field name="margin_reduced_50_payout_factor" widget="percentage"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_commission_plans" model="ir.actions.act_window">
        <field name="name">Commission Plans</field>
        <field name="res_model">commission.plan</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_commission_plan_settings"
              name="Commission Plans"
              parent="menu_unico_commission_gp_reporting"
              action="action_commission_plans"
              sequence="40"
              groups="unico_commission_gp_reporting.group_unico_commission_gp_manager"/>
</odoo>
